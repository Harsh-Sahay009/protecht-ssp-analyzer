# Copy to .env and fill in real values. Never commit .env.

# Optional: enables LLM-generated remediation recommendations (gpt-3.5-turbo via the
# OpenAI Chat Completions API). Without it, proTecht uses its rule-based recommendations.
OPENAI_API_KEY=your-openai-api-key-here

# Optional server settings (defaults shown)
HOST=127.0.0.1
PORT=5000
# Set to 1 only for local development; enables the Werkzeug debugger and auto-reload.
FLASK_DEBUG=0
